<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.3</version>
		<relativePath/>
	</parent>
	<groupId>net.snobo</groupId>
	<artifactId>rate-payment-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>rate-payment-service-case-study</name>
	<description>Case study implementing a Spring Boot+Maven based rate payment service.</description>
	<url>https://github.com/DevSnobo/rate-payment-service-case-study</url>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer>
			<name>Robin Fritz</name>
			<email>admin@snobo.net</email>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/DevSnobo/rate-payment-service-case-study.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/DevSnobo/artifact-stores-gradle-plugin.git</developerConnection>
		<tag/>
		<url>https://github.com/DevSnobo/rate-payment-service-case-study</url>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
